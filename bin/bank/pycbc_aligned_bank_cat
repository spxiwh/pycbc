"""
Program for concatenating the output of the geometric aligned bank dagman.
This will gather all the meta-output files and create a valid template bank
xml file.
"""
import glob
import argparse
import numpy
from igwn_ligolw import utils
from pycbc import tmpltbank
# Old ligolw output functions no longer imported at package level
import pycbc.tmpltbank.bank_output_utils as bank_output
import pycbc
import pycbc.psd
import pycbc.strain
import pycbc.version
from pycbc.io.ligolw import LIGOLWContentHandler
from pycbc.io.hdf import HFile
from pycbc.types import positive_float


__author__  = "Ian Harry <ian.harry@astro.cf.ac.uk>"
__version__ = pycbc.version.git_verbose_msg
__date__    = pycbc.version.date
__program__ = "pycbc_aligned_bank_cat"

# Read command line options
parser = argparse.ArgumentParser(description=__doc__,
           formatter_class=tmpltbank.IndentedHelpFormatterWithNL)

pycbc.add_common_pycbc_options(parser)
parser.add_argument("-i", "--input-glob",
                    help="file glob the list of paramters")
parser.add_argument("-I", "--input-files", nargs='+',
                    help="Explicit list of input files.")
parser.add_argument("-O", "--output-file",
                    help="Output file to write the bank to.")
parser.add_argument("--metadata-file", metavar="METADATA_FILE",
                  help="XML file containing the process and process_params "
                  "tables that the aligned_bank code was run with.")
parser.add_argument("--f-low", action="store", type=positive_float,
                    required=True,
                    help="Lower frequency cutoff used in computing the "
                    "parameter space metric.  REQUIRED. UNITS=Hz")
parser.add_argument("--f-upper", action="store", type=positive_float,
                    required=True,
                    help="Upper frequency cutoff used in computing the "
                    "parameter space metric.  REQUIRED. UNITS=Hz")
parser.add_argument('--output-f-final', action='store_true', default=False,
                    help="Include 'f_final' in the output hdf file.")


options = parser.parse_args()

pycbc.init_logging(options.verbose)


if options.input_files:
    input_files = options.input_files
else:
    input_files = glob.glob(options.input_glob)

# Accumulate the accepted templates into a single preallocated numpy array.
# Using numpy throughout (rather than Python lists of floats) keeps each value
# as a packed 8-byte double instead of a ~40-byte Python object, which matters
# a great deal when concatenating tens of thousands of split-bank files.
# First pass: total number of templates, reading dataset metadata only.
n_total = 0
for inp_file in input_files:
    with HFile(inp_file, 'r') as inp_fp:
        n_total += inp_fp['accepted_templates'].shape[0]

# Second pass: copy columns 1-4 (mass1, mass2, spin1z, spin2z; column 0 is the
# lattice index and column 5 the mismatch) straight into the output array.
temp_bank = numpy.empty((n_total, 4), dtype=numpy.float64)
offset = 0
for inp_file in input_files:
    with HFile(inp_file, 'r') as inp_fp:
        accepted = inp_fp['accepted_templates']
        n = accepted.shape[0]
        if n:
            temp_bank[offset:offset+n] = accepted[:, 1:5]
    offset += n

if options.metadata_file:
    outdoc = utils.load_filename(options.metadata_file,
                                 compress='auto',
                                 contenthandler=LIGOLWContentHandler)
else:
    outdoc = None

bank_output.output_bank_to_file(
    options.output_file,
    temp_bank,
    programName=__program__,
    output_duration=True,
    approximant="TaylorF2",
    optDict=options.__dict__,
    outdoc=outdoc
)
